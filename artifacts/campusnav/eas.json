{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "cache": {
        "disabled": false
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "EXPO_PUBLIC_API_URL": "https://campusnav-ph.vercel.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "cache": {
        "disabled": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://campusnav-ph.vercel.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
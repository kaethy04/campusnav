{
  "buildCommand": "pnpm --filter @workspace/api-server run vercel-build",
  "builds": [
    {
      "src": "artifacts/admin/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "artifacts/api-server/dist/vercel.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "artifacts/api-server/dist/vercel.mjs"
    },
    {
      "src": "/(.*)",
      "dest": "artifacts/admin/$1"
    }
  ]
}